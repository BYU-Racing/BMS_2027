{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Blinky",
            "inherits": "Debug",
            "cacheVariables": {
                "FIRMWARE": "blinky"
            }
        },
        {
            "name": "Bms",
            "inherits": "Debug",
            "cacheVariables": {
                "FIRMWARE": "bms"
            }
        },
        {
            "name": "QspiTest",
            "inherits": "Debug",
            "cacheVariables": {
                "FIRMWARE": "peripheral_test"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        { "name": "Blinky",   "configurePreset": "Blinky" },
        { "name": "Bms",      "configurePreset": "Bms" },
        { "name": "QspiTest", "configurePreset": "QspiTest" }
    ]
}