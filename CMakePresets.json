{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Debug-Nucleo",
            "inherits": "Debug",
            "displayName": "Debug (Nucleo + VCP printf)",
            "cacheVariables": {
                "NUCLEO_DEBUG": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug-Nucleo",
            "configurePreset": "Debug-Nucleo"
        }
    ],
    "testPresets": [
        {
            "name": "test_ltc6811",
            "description": "",
            "displayName": "",
            "configurePreset": "Debug"
        }
    ]
    
}